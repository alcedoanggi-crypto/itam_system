# Copia este archivo como .env y completa tus valores.
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave
DATABASE_URL=postgresql://usuario:password@localhost:5432/tecnologico?client_encoding=utf8
# 1 = modo desarrollo (recarga automática y depurador). Nunca en producción.
FLASK_DEBUG=1
